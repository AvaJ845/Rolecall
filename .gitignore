# internal docs — kept on disk, out of the repo
_private/

# build outputs / local data
data/*.db
data/*.db-wal
data/*.db-shm
data/*.json
data/*.jsonl
data/*.sig
!data/.gitkeep

# python
__pycache__/
*.pyc
.venv/
venv/

# xcode / ios build artifacts
ios/build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/**/*.xcodeproj/xcuserdata/
# macOS rename-on-conflict cruft
*[0-9].xcodeproj

# web build output
web/dist/

# macOS / editors
.DS_Store
.idea/
.vscode/

# ad-hoc site zips (use the workflow, not manual upload)
web/*.zip

# app store: raw simulator captures (regenerated by the UI test); keep the framed set
ios/AppStore/raw/
